{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "associative-memory": {
      "type": "local",
      "command": ["node", "--env-file-if-exists=.env", "src/runtime/start.ts"],
      "cwd": ".",
      "enabled": true,
      "timeout": 300000
    }
  },
  "instructions": ["AGENTS.md"],
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "associative-memory_*": "deny"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "associative-memory_*": "deny"
      }
    }
  }
}
