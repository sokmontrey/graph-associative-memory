# Associative graph memory — example environment.
# Copy to `.env`; it is loaded via `node --env-file-if-exists=.env` by the npm
# scripts and by opencode.json. Every value below is optional — the defaults
# in parentheses apply when the variable is unset.

# --- Database -------------------------------------------------------------
# Isolated database file. Default: ./data/ladybug.
# MEMORY_DB_PATH=./data/ladybug
# (LBUG_DB_PATH is honoured as a legacy fallback for the same setting.)

# --- Server / transports --------------------------------------------------
# Dashboard HTTP port. (4317)
# MEMORY_PORT=4317
# Turn off either half of the single-process runtime:
# MEMORY_MCP=0
# MEMORY_DASHBOARD=0

# --- Embedder -------------------------------------------------------------
# EmbeddingGemma-300M (768 dims). Its model (~300 MB) downloads once on first
# run into ./local_cache, then runs offline. Quantization: q8 (default, ~300 MB),
# fp32, or q4. Gemma does not support fp16.
# MEMORY_GEMMA_DTYPE=q8

# --- Grounding (memory_propose_links) ------------------------------------
# Required by memory_propose_links (TypeSafe / Jev). https://typesafe.ai
# TYPESAFE_API_KEY=
